{
  "name": "tree-sitter-dfm",
  "version": "1.1.0",
  "description": "Tree-sitter grammar for Delphi DFM (Form file) text format",
  "main": "bindings/node",
  "types": "bindings/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexl-git/tree-sitter-dfm.git"
  },
  "keywords": [
    "parser",
    "tree-sitter",
    "delphi",
    "dfm",
    "vcl",
    "fmx"
  ],
  "homepage": "https://github.com/Alexl-git/tree-sitter-dfm",
  "bugs": {
    "url": "https://github.com/Alexl-git/tree-sitter-dfm/issues"
  },
  "author": "Alexander Liberov",
  "license": "MIT",
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "web-tree-sitter": "^0.24.7",
    "tree-sitter-cli": "^0.24.5"
  },
  "scripts": {
    "build": "tree-sitter generate && node-gyp build",
    "build-wasm": "tree-sitter build --wasm -o tree-sitter-dfm.wasm .",
    "test": "tree-sitter test && tree-sitter parse examples/* --quiet --time",
    "install": "node-gyp-build",
    "validate-queries": "node tools/validate-queries.js",
    "prebuildify": "prebuildify --napi --strip"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "tree-sitter.json",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "tree-sitter-dfm.wasm"
  ],
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  }
}
